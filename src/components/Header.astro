---
/**
 * Header v4a — redesign dle design handoffu (Claude design, 2026-07-19).
 *
 * Desktop: dvouřádkový. Řádek 1 = logo + vyhledávání (Pagefind → /hledat/)
 * + akviziční blok (Služby/Audit/Návod zdarma). Řádek 2 = disciplíny
 * s hover/click dropdown náhledy + doplňky (Blog/Průvodce/Slovník).
 * Mobil (<1000px): sbalená lišta (logo + lupa + ☰) a drawer se search,
 * seznamem disciplín, doplňky a stackovanými CTA.
 *
 * Texty/odkazy: nav.header v i18n/strings.ts (fork přeloží).
 * Barvy: design tokeny handoffu, scoped na header (--h-*).
 * Backdrop + drawer jsou mimo <header> (backdrop-filter = containing block
 * pro fixed potomky — viz původní gotcha).
 */
import { nav } from "~/i18n/strings";
import { site } from "~/i18n/site";

const h = nav.header;
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== "/" && currentPath.startsWith(href));

/** Design tokeny disciplín (dot / badge) — sdílené, fork nemění. */
const DISC = {
  seo: { color: "#2b4fd8", bg: "#f4f6fe", border: "#cdd7fa" },
  geo: { color: "#12854a", bg: "#edf8f1", border: "#bfe6cd" },
  aeo: { color: "#a06514", bg: "#fdf5e6", border: "#f0dcb4" },
  aio: { color: "#7a34c9", bg: "#f6eefc", border: "#ddc7f5" },
  aimode: { color: "#1466ff", bg: "#eef3fd", border: "#bcd0f7" },
} as Record<string, { color: string; bg: string; border: string }>;
---

<header class="hdr">
  <!-- ŘÁDEK 1 — logo · search · akvizice -->
  <div class="hdr__row1">
    <div class="hdr__inner hdr__inner--row1">
      {/* Logo — PŮVODNÍ podoba (v handoffu byl jen placeholder, nezasahovat). */}
      <a href="/" class="brand" aria-label={nav.brandAria}>
        <span class="brand__sigil" aria-hidden="true"></span>
        <span class="brand__name">
          <span class="brand__name-strong">{site.brand.strong}</span><span class="brand__name-rest">{site.brand.rest}</span><span class="brand__name-tld">{site.brand.tld}</span>
        </span>
      </a>

      <form class="hsearch" role="search" action={h.search.action} method="get" aria-label={h.search.aria}>
        <svg class="hsearch__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2" />
          <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
        <input class="hsearch__input" type="search" name="q" placeholder={h.search.placeholder} aria-label={h.search.aria} autocomplete="off" />
        <button class="hsearch__btn" type="submit">{h.search.button}</button>
      </form>

      <div class="hcta">
        {h.acquisitions.map((a) => (
          <a href={a.href} class:list={["hcta__btn", `hcta__btn--${a.variant}`]} aria-current={isActive(a.href) ? "page" : undefined}>{a.label}</a>
        ))}
      </div>

      <!-- Mobil: lupa + ☰ -->
      <div class="mtools">
        <a href={h.search.action} class="mtools__search" aria-label={h.mobile.searchAria}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2" />
            <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
        </a>
        <button
          type="button"
          class="mtools__burger"
          aria-label={nav.openLabel}
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-nav-toggle
          data-label-open={nav.openLabel}
          data-label-close={nav.closeLabel}
        >
          <span class="mtools__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- ŘÁDEK 2 — disciplíny + doplňky (jen desktop) -->
  <div class="hdr__row2" data-disc-row>
    <div class="hdr__inner hdr__inner--row2">
      <nav class="dnav" aria-label={nav.navAria}>
        {h.disciplines.map((item) => {
          const t = DISC[item.d];
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={["dnav__link", { "dnav__link--active": active }]}
              style={`--dc:${t.color}`}
              data-disc-link={item.d}
              aria-current={active ? "page" : undefined}
            >
              <span class="dnav__dot" aria-hidden="true"></span>
              {item.label}
            </a>
          );
        })}
      </nav>
      <span class="hdr__sep" aria-hidden="true"></span>
      <nav class="anav" aria-label={nav.mobileAria}>
        {h.addons.map((a) => (
          <a href={a.href} class:list={["anav__link", { "anav__link--active": isActive(a.href) }]} aria-current={isActive(a.href) ? "page" : undefined}>{a.label}</a>
        ))}
      </nav>
    </div>

    <!-- Dropdown náhledy disciplín -->
    <div class="ddrop" data-disc-drop hidden>
      <div class="hdr__inner">
        {h.disciplines.map((item) => {
          const t = DISC[item.d];
          return (
            <div class="ddrop__card" data-disc-card={item.d} hidden>
              <span class="ddrop__badge" style={`color:${t.color};background:${t.bg};border-color:${t.border}`}>{item.badge}</span>
              <div class="ddrop__body">
                <p class="ddrop__title">{item.fullName}</p>
                <p class="ddrop__lead">{item.lead}</p>
                <p class="ddrop__desc">{item.desc}</p>
                <a class="ddrop__cta" href={item.href} style={`color:${t.color}`}>{h.dropdownCta}</a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</header>

<!-- Backdrop + drawer mimo <header> (backdrop-filter gotcha) -->
<div class="mobile-nav-backdrop" data-mobile-backdrop aria-hidden="true"></div>

<nav class="mnav" id="mobile-nav" aria-label={nav.mobileAria} data-mobile-nav>
  <div class="mnav__head">
    <span class="mnav__title">{nav.menuLabel}</span>
    <button type="button" class="mnav__close" data-nav-close aria-label={nav.closeLabel}>
      <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <div class="mnav__body">
    <form class="msearch" role="search" action={h.search.action} method="get" aria-label={h.search.aria}>
      <svg class="msearch__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2" />
        <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
      <input class="msearch__input" type="search" name="q" placeholder={h.search.placeholderMobile} aria-label={h.search.aria} autocomplete="off" />
      <button class="msearch__btn" type="submit">{h.search.button}</button>
    </form>

    <span class="mnav__eyebrow">{h.mobile.disciplinesTitle}</span>
    <ul class="mnav__list">
      {h.disciplines.map((item) => {
        const t = DISC[item.d];
        return (
          <li>
            <a href={item.href} class="mnav__disc" style={`--dc:${t.color}`} aria-current={isActive(item.href) ? "page" : undefined}>
              <span class="mnav__dot" aria-hidden="true"></span>
              <span class="mnav__disc-label">{item.label}</span>
              <span class="mnav__chevron" aria-hidden="true">›</span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="mnav__addons">
      {h.addons.map((a) => (
        <a href={a.href} class="mnav__addon">{a.label}</a>
      ))}
    </div>

    <div class="mnav__ctas">
      {h.acquisitions.map((a) => (
        <a href={a.href} class:list={["mnav__cta", `mnav__cta--${a.variant}`]}>{a.label}</a>
      ))}
    </div>
  </div>
</nav>

<style>
  /* ===== Design tokeny handoffu (scoped) ===== */
  .hdr,
  .mnav {
    --h-ink: #0e1526;
    --h-body: #4c5568;
    --h-sec: #3d4557;
    --h-muted: #8a93a5;
    --h-placeholder: #9aa2b2;
    --h-chevron: #c3ccd8;
    --h-field: #f4f6fa;
    --h-line-soft: #eef1f6;
    --h-line-softer: #f1f3f7;
    --h-line: #e2e6ee;
    --h-line-btn: #dbe0ea;
    --h-blue: #1466ff;
    --h-blue-hover: #0f4fd0;
    --h-focus-ring: rgba(20, 102, 255, 0.14);
    --h-audit-bg: #f8d4ec;
    --h-audit-text: #a01f78;
    --h-free-bg: #f7c25c;
    --h-free-text: #6a4a06;
    --h-free-shadow: rgba(240, 180, 60, 0.4);
  }

  /* ===== Skelet ===== */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #ffffff;
    font-family: var(--font-sans);
  }
  .hdr__inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .hdr__row1 {
    border-bottom: 1px solid var(--h-line-soft);
  }
  .hdr__inner--row1 {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 15px;
    padding-bottom: 15px;
  }
  .hdr__row2 {
    position: relative;
  }
  .hdr__inner--row2 {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-top: 12px;
    padding-bottom: 12px;
  }

  /* ===== Logo — původní podoba (před redesignem headeru) ===== */
  .brand {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    letter-spacing: -0.022em;
    color: var(--color-ink);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    text-decoration: none;
    transition: opacity 0.18s ease;
  }
  .brand:hover { opacity: 0.78; }
  .brand__sigil {
    width: 24px;
    height: 24px;
    background: var(--color-ink);
    border-radius: 6px;
    display: inline-block;
    position: relative;
    flex: none;
    transition: background 0.18s ease;
  }
  .brand__sigil::before {
    content: "";
    position: absolute;
    inset: 5px;
    background: var(--color-paper);
    border-radius: 2px;
  }
  .brand:hover .brand__sigil { background: var(--color-accent); }
  .brand__name {
    display: inline-flex;
    align-items: baseline;
  }
  .brand__name-strong {
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.028em;
  }
  .brand__name-rest {
    font-weight: 500;
    color: var(--color-ink);
  }
  .brand__name-tld {
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  /* ===== Vyhledávání (desktop) ===== */
  /* Výška sladěná s CTA tlačítky vpravo (44px) — viz --h-control. */
  .hdr { --h-control: 44px; }
  .hsearch {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 11px;
    max-width: 460px;
    height: var(--h-control);
    box-sizing: border-box;
    margin: 0 auto;
    padding: 4px 4px 4px 18px;
    border-radius: 999px;
    background: var(--h-field);
    border: 1.5px solid var(--h-line);
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .hsearch:focus-within {
    background: #fff;
    border-color: var(--h-blue);
    box-shadow: 0 0 0 4px var(--h-focus-ring);
  }
  .hsearch__icon { color: var(--h-muted); flex: none; }
  .hsearch__input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--h-ink);
    background: none;
    border: none;
    outline: none;
    padding: 0;
  }
  .hsearch__input::placeholder { color: var(--h-placeholder); }
  .hsearch__input::-webkit-search-cancel-button { display: none; }
  .hsearch__btn {
    flex: none;
    align-self: stretch;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 14.5px;
    font-weight: 700;
    color: #fff;
    background: var(--h-blue);
    border: none;
    border-radius: 999px;
    padding: 0 20px;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .hsearch__btn:hover { background: var(--h-blue-hover); }

  /* ===== Akviziční blok ===== */
  .hcta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .hcta__btn {
    display: inline-flex;
    align-items: center;
    height: var(--h-control);
    box-sizing: border-box;
    font-size: 15px;
    font-weight: 700;
    padding: 0 17px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .hcta__btn--outline {
    background: #fff;
    border: 1.5px solid var(--h-line-btn);
    color: var(--h-sec);
  }
  .hcta__btn--outline:hover { border-color: var(--h-ink); color: var(--h-ink); }
  .hcta__btn--audit {
    background: var(--h-audit-bg);
    color: var(--h-audit-text);
  }
  .hcta__btn--audit:hover { filter: brightness(0.97); }
  .hcta__btn--free {
    background: var(--h-free-bg);
    color: var(--h-free-text);
    padding: 0 19px;
    box-shadow: 0 6px 16px var(--h-free-shadow);
  }
  .hcta__btn--free:hover {
    transform: translateY(-1px);
    box-shadow: 0 9px 22px rgba(240, 180, 60, 0.5);
  }

  /* ===== Disciplíny (řádek 2) ===== */
  .dnav {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .dnav__link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 16px;
    font-weight: 600;
    color: var(--h-sec);
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 10px;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }
  .dnav__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--dc);
    flex: none;
  }
  .dnav__link:hover,
  .dnav__link--open,
  .dnav__link--active {
    background: var(--h-field);
    color: var(--dc);
  }

  .hdr__sep {
    width: 1px;
    height: 20px;
    background: var(--h-line);
    flex: none;
  }

  /* ===== Doplňky ===== */
  .anav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .anav__link {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--h-muted);
    text-decoration: none;
    transition: color 0.15s ease;
    white-space: nowrap;
  }
  .anav__link:hover,
  .anav__link--active { color: var(--h-sec); }

  /* ===== Dropdown náhled disciplíny ===== */
  .ddrop {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 60;
  }
  .ddrop .hdr__inner { padding-bottom: 20px; }
  .ddrop__card {
    display: flex;
    gap: 20px;
    max-width: 640px;
    background: #fff;
    border: 1px solid #e3e7ee;
    border-radius: 16px;
    box-shadow: 0 24px 50px rgba(15, 25, 50, 0.16);
    padding: 22px 24px;
  }
  .ddrop__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 7px 11px;
    border-radius: 9px;
    border: 1.5px solid;
    white-space: nowrap;
  }
  .ddrop__title {
    font-size: 18px;
    font-weight: 700;
    color: var(--h-ink);
    margin: 0 0 2px;
  }
  .ddrop__lead {
    font-size: 15px;
    font-weight: 700;
    color: var(--h-ink);
    margin: 0 0 6px;
  }
  .ddrop__desc {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--h-body);
    margin: 0 0 10px;
  }
  .ddrop__cta {
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
  }
  .ddrop__cta:hover { text-decoration: underline; }

  /* ===== Mobilní nástroje (lupa + burger) ===== */
  .mtools {
    display: none;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .mtools__search,
  .mtools__burger {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .mtools__search {
    background: var(--h-field);
    border: 1px solid var(--h-line);
    color: #5a6478;
  }
  .mtools__burger {
    background: var(--h-ink);
    border: none;
  }
  .mtools__bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mtools__bars span {
    display: block;
    width: 16px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .mtools__burger[aria-expanded="true"] .mtools__bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .mtools__burger[aria-expanded="true"] .mtools__bars span:nth-child(2) { opacity: 0; }
  .mtools__burger[aria-expanded="true"] .mtools__bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* ===== Breakpoint: pod 1000px mobil ===== */
  @media (max-width: 999px) {
    .hsearch, .hcta, .hdr__row2 { display: none; }
    .mtools { display: flex; }
    /* Safe zóna: min. 20px od hran + respekt notche/dynamic islandu
       (env() se uplatní na zařízeních s výřezem, jinde je 0). */
    .hdr__inner {
      padding-left: max(20px, env(safe-area-inset-left));
      padding-right: max(20px, env(safe-area-inset-right));
    }
    .hdr__row1 { padding-top: env(safe-area-inset-top); }
    .hdr__inner--row1 { padding-top: 14px; padding-bottom: 14px; gap: 16px; }
    .brand { font-size: 1rem; }
  }
  @media (min-width: 1000px) {
    .mtools { display: none; }
  }

  /* ===== Backdrop + drawer ===== */
  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(14, 21, 38, 0.4);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .mobile-nav-backdrop--open {
    opacity: 1;
    visibility: visible;
  }
  .mnav {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    width: min(82vw, 360px);
    background: #fff;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.28s cubic-bezier(0.3, 0.7, 0.3, 1), visibility 0.28s;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    font-family: var(--font-sans);
  }
  .mnav--open {
    transform: translateX(0);
    visibility: visible;
  }
  .mnav__head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(16px + env(safe-area-inset-top)) max(20px, env(safe-area-inset-right)) 16px 20px;
    border-bottom: 1px solid var(--h-line-soft);
  }
  .mnav__title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--h-muted);
  }
  .mnav__close {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--h-line);
    background: var(--h-field);
    color: var(--h-sec);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .mnav__body {
    flex: 1;
    overflow-y: auto;
    padding: 16px max(20px, env(safe-area-inset-right)) calc(22px + env(safe-area-inset-bottom)) 20px;
  }

  .msearch {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--h-field);
    border: 1.5px solid var(--h-line);
    border-radius: 14px;
    padding: 5px 5px 5px 14px;
    margin-bottom: 18px;
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .msearch:focus-within {
    background: #fff;
    border-color: var(--h-blue);
    box-shadow: 0 0 0 4px var(--h-focus-ring);
  }
  .msearch__icon { color: #5a6478; flex: none; }
  .msearch__input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--h-ink);
    background: none;
    border: none;
    outline: none;
  }
  .msearch__input::placeholder { color: var(--h-placeholder); }
  .msearch__btn {
    flex: none;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    background: var(--h-blue);
    border: none;
    border-radius: 10px;
    padding: 10px 16px;
    cursor: pointer;
  }

  .mnav__eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--h-muted);
    margin-bottom: 4px;
  }
  .mnav__list {
    list-style: none;
    margin: 0 0 4px;
    padding: 0;
  }
  .mnav__disc {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 8px;
    border-bottom: 1px solid var(--h-line-softer);
    font-size: 16px;
    font-weight: 600;
    color: var(--h-ink);
    text-decoration: none;
  }
  .mnav__dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--dc);
    flex: none;
  }
  .mnav__disc-label { flex: 1; }
  .mnav__chevron { color: var(--h-chevron); font-size: 18px; }

  .mnav__addons {
    display: flex;
    gap: 20px;
    padding: 16px 8px;
    border-top: 1px solid var(--h-line-soft);
    margin-top: 8px;
  }
  .mnav__addon {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--h-muted);
    text-decoration: none;
  }
  .mnav__addon:hover { color: var(--h-sec); }

  .mnav__ctas {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 10px;
  }
  .mnav__cta {
    display: block;
    text-align: center;
    padding: 13px;
    border-radius: 13px;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
  }
  .mnav__cta--outline {
    background: #fff;
    border: 1.5px solid var(--h-line-btn);
    color: var(--h-sec);
  }
  .mnav__cta--audit { background: var(--h-audit-bg); color: var(--h-audit-text); }
  .mnav__cta--free {
    background: var(--h-free-bg);
    color: var(--h-free-text);
    box-shadow: 0 6px 16px var(--h-free-shadow);
  }

  @media (prefers-reduced-motion: reduce) {
    .mnav, .mobile-nav-backdrop, .mtools__bars span { transition: none; }
  }
</style>

<script>
  // ===== Dropdown náhledy disciplín (desktop) =====
  // Hover pattern vázaný na TLAČÍTKO + KARTU: otevřeno jen dokud je kurzor
  // nad disciplínou nebo nad dropdownem; opuštění obojího zavírá s krátkou
  // prodlevou (přejezd mezi tlačítkem a kartou). Focus/Esc/klik mimo řeší
  // klávesnici a dotyk. Vždy max jedna karta.
  function initDiscDropdown() {
    const row = document.querySelector("[data-disc-row]");
    const drop = document.querySelector<HTMLElement>("[data-disc-drop]");
    if (!row || !drop) return;
    const links = Array.from(row.querySelectorAll<HTMLElement>("[data-disc-link]"));
    const cards = Array.from(drop.querySelectorAll<HTMLElement>("[data-disc-card]"));
    let openKey: string | null = null;
    let closeTimer: number | undefined;

    const close = () => {
      window.clearTimeout(closeTimer);
      openKey = null;
      drop.hidden = true;
      cards.forEach((c) => (c.hidden = true));
      links.forEach((l) => l.classList.remove("dnav__link--open"));
    };
    const scheduleClose = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(close, 120);
    };
    const open = (key: string) => {
      window.clearTimeout(closeTimer);
      openKey = key;
      drop.hidden = false;
      cards.forEach((c) => (c.hidden = c.dataset.discCard !== key));
      links.forEach((l) => l.classList.toggle("dnav__link--open", l.dataset.discLink === key));
    };

    links.forEach((link) => {
      const key = link.dataset.discLink!;
      link.addEventListener("mouseenter", () => open(key));
      link.addEventListener("mouseleave", scheduleClose);
      link.addEventListener("focus", () => open(key));
      link.addEventListener("blur", scheduleClose);
    });
    drop.addEventListener("mouseenter", () => window.clearTimeout(closeTimer));
    drop.addEventListener("mouseleave", scheduleClose);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && openKey) close();
    });
    document.addEventListener("click", (e) => {
      if (openKey && e.target instanceof Node && !row.contains(e.target)) close();
    });
  }

  // ===== Mobilní drawer =====
  function initDrawer() {
    const toggle = document.querySelector<HTMLElement>("[data-nav-toggle]");
    const drawer = document.querySelector<HTMLElement>("[data-mobile-nav]");
    const backdrop = document.querySelector<HTMLElement>("[data-mobile-backdrop]");
    const closeBtn = document.querySelector<HTMLElement>("[data-nav-close]");
    if (!toggle || !drawer || !backdrop) return;

    const setOpen = (openState: boolean) => {
      drawer.classList.toggle("mnav--open", openState);
      backdrop.classList.toggle("mobile-nav-backdrop--open", openState);
      toggle.setAttribute("aria-expanded", String(openState));
      toggle.setAttribute(
        "aria-label",
        openState ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!,
      );
      document.documentElement.style.overflow = openState ? "hidden" : "";
    };

    toggle.addEventListener("click", () => setOpen(!drawer.classList.contains("mnav--open")));
    closeBtn?.addEventListener("click", () => setOpen(false));
    backdrop.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer.classList.contains("mnav--open")) setOpen(false);
    });
    drawer.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

    // Přechod na desktop breakpoint zavře (čistý stav)
    const mq = window.matchMedia("(min-width: 1000px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  initDiscDropdown();
  initDrawer();
</script>
